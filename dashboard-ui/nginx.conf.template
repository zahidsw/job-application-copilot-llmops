server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass __API_UPSTREAM_URL__/api/;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /live {
        proxy_pass __API_UPSTREAM_URL__/live;
        proxy_http_version 1.1;
    }

    location = /ready {
        proxy_pass __API_UPSTREAM_URL__/ready;
        proxy_http_version 1.1;
    }

    location = /metrics {
        proxy_pass __API_UPSTREAM_URL__/metrics;
        proxy_http_version 1.1;
    }

    location = /tool-api/ready {
        proxy_pass __TOOL_UPSTREAM_URL__/ready;
        proxy_http_version 1.1;
    }

    location /tool-api/ {
        proxy_pass __TOOL_UPSTREAM_URL__/api/v1/tools/;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
