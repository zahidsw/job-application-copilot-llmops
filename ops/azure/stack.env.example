DEPLOYMENT_ENVIRONMENT=test
AZURE_RESOURCE_GROUP=job-application-copilot-test-rg
AZURE_LOCATION=switzerlandnorth
AZURE_BASE_NAME=jobappcopilottest
AZURE_POSTGRES_ADMIN_USER=jobappadmin

# For prod, use a separate environment and names:
# DEPLOYMENT_ENVIRONMENT=prod
# AZURE_RESOURCE_GROUP=job-application-copilot-prod-rg
# AZURE_BASE_NAME=jobappcopilotprod

# Set these as secrets in GitHub or pass them to deploy.ps1 locally.
POSTGRES_ADMIN_PASSWORD=
MCP_CLIENT_AUTH_TOKEN=
GRAFANA_ADMIN_PASSWORD=
SMTP_PASSWORD=

# These map directly from C:\Users\marya\Documents\New project\multi-agent-research-llmops\.env
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=llama3.1-8b
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=400
REQUEST_TIMEOUT_SECONDS=60

# Keep the API key in Azure or GitHub secrets only.
LLM_API_KEY=
