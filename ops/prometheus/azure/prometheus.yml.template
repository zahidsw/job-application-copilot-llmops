global:
  scrape_interval: 15s

scrape_configs:
  - job_name: api
    metrics_path: /metrics
    scheme: __API_METRICS_SCHEME__
    static_configs:
      - targets:
          - __API_METRICS_TARGET__

  - job_name: mcp
    metrics_path: /metrics
    scheme: __MCP_METRICS_SCHEME__
    static_configs:
      - targets:
          - __MCP_METRICS_TARGET__
