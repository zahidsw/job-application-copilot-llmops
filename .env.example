ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8080
MCP_PORT=8081
EVAL_PORT=8090

DATABASE_URL=postgresql+psycopg://jobapp:jobapp@postgres:5432/jobapp
ARTIFACTS_DIR=/app/data/artifacts
PROFILES_DIR=/app/data/profiles
REPORTS_DIR=/app/data/reports

MATCH_THRESHOLD=70
ALLOWED_SOURCE_DOMAINS=greenhouse.io,lever.co,workday.com,smartrecruiters.com,linkedin.com,indeed.com
MANUAL_ONLY_DOMAINS=linkedin.com,indeed.com
SIMILAR_JOB_SEARCH_PROVIDER=serpapi
SIMILAR_JOB_MIN_SCORE=80
SERPAPI_API_KEY=
DEFAULT_TENANT_ID=local-dev
REQUIRE_TENANT_HEADER=false
ALLOWED_TENANTS=local-dev
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://model:8000/v1
LLM_API_KEY=local
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
REQUEST_TIMEOUT_SECONDS=60

MCP_SERVER_URL=http://mcp:8081
MCP_VERIFY_SSL=true
MCP_CLIENT_SERVICE_NAME=job-app-api
MCP_CLIENT_AUTH_TOKEN=change-me-api-token

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=job-application-copilot
MLFLOW_EVAL_EXPERIMENT_NAME=job-application-copilot-evals

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-application-copilot-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
COMPANY_SITE_AUTO_OPEN=false
